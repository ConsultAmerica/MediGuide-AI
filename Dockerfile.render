FROM python:3.11-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    DATABASE_URL=sqlite:///data/mediguide.db

# Local OCR for scanned PDFs and photos (src/ocr.py). Runs in-container;
# documents are never sent to an external OCR service.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng tesseract-ocr-osd \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-render.txt .
RUN pip install --no-cache-dir -r requirements-render.txt

COPY api.py ingest_knowledge.py ./
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./
COPY data/knowledge ./data/knowledge
COPY data/samples ./data/samples

RUN mkdir -p data outputs/document_intelligence

EXPOSE 8000
CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port ${PORT:-8000}"]
