OLLAMA_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434

MAX_HISTORY_MESSAGES=12
MODEL_TEMPERATURE=0.2

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_MB=25

MAX_IMAGE_MB=10
MAX_IMAGE_WIDTH=2400
MAX_IMAGE_HEIGHT=2400

OLLAMA_EMBEDDING_MODEL=embeddinggemma

KNOWLEDGE_DIR=data/knowledge/approved
VECTOR_STORE_DIR=data/vector_store
CHROMA_COLLECTION_NAME=mediguide_trusted_medical_knowledge

RAG_TOP_K=6
RAG_MAX_DISTANCE=1.2

CHUNK_SIZE_WORDS=350
CHUNK_OVERLAP_WORDS=60

# Local demo default (SQLite). For Postgres via docker-compose:
# DATABASE_URL=postgresql+psycopg://mediguide:mediguide@localhost:5432/mediguide
DATABASE_URL=sqlite:///data/mediguide.db

# Frontend (Vercel / Next.js) — set in frontend/.env.local or Vercel env vars:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Production must be an HTTPS FastAPI URL (not localhost):
# NEXT_PUBLIC_API_URL=https://mediguide-api.onrender.com

# Seconds to wait for a local text-model reply (chat answers, medication
# label reading). 20 suits a GPU; CPU-only machines running gemma3:4b often
# need 60-90 or answers fail with "AI service temporarily unavailable".
# OLLAMA_TIMEOUT_SECONDS=20
